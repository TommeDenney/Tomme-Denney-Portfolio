# R2 S3 API credentials, for pushing the files Pages cannot host.
# Cloudflare dashboard > R2 > Manage API tokens. Shown once at creation.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Optional. Overrides the r2.dev default in src/lib/assets.ts once the bucket
# is behind a custom domain, e.g. https://assets.tommedenney.com
PUBLIC_ASSET_BASE=

# Zone > DNS > Edit on tommedenney.com. Used by scripts/point-dns.mjs.
CLOUDFLARE_API_TOKEN=
