---
/**
 * The chrome that sits above every mode: the custom cursor, the dev/photo
 * switch, the lightbox and the palette picker.
 */
---
{/* Two elements, not one: #cur tracks the pointer exactly while #ring eases
    toward it, which is what produces the trailing ring. */}
<div id="cur"></div><div id="ring"></div>

<div id="mode-switch">
    <div class="mode-opt active" id="mode-dev" onclick="switchMode('dev')">XR / Dev</div>
    <div class="mode-opt" id="mode-photo" onclick="switchMode('photo')">Photography</div>
</div>

<div id="lightbox">
    <div id="lb-ov" onclick="closeLightbox()"></div>
    <img id="lb-img" src="" alt="" />
    <button id="lb-close" onclick="closeLightbox()">✕</button>
</div>

<div id="pal">
    <div class="swatches" id="sw">
        {/* Both themes are drawn from the Vintage Charm palette and nothing
            else. Wheat-on-ink and ink-on-wheat are each 13.15:1, so the choice
            is taste rather than a legibility compromise. */}
        <div class="sw on" onclick="setTheme('',this)"><span>Wheat</span><div class="sdot" style="background:#efd6ac"></div></div>
        <div class="sw" onclick="setTheme('ink',this)"><span>Ink</span><div class="sdot" style="background:#04151f"></div></div>
    </div>
    <button id="pbtn" onclick="togglePal()">🎨</button>
</div>
