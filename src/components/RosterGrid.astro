---
/**
 * One section of a project's roster: a label, an optional note, and a grid of
 * ruled cells.
 *
 * This exists because See Reality is not one project and is not a case study
 * either — it is two dozen deployed experiences, and the readable form for that
 * is a grid where each cell says what one of them is. The cell is deliberately
 * not the site's `.feature` card: a feature card is a link with a caption, and
 * these need a paragraph, a metadata line, and sometimes two links and
 * sometimes none. So the whole cell is not an anchor; the name is, where there
 * is somewhere to go, which also keeps an operator's link out of a nested
 * anchor.
 *
 * Media resolves in priority order and every branch is checked against the
 * disk first, so an item whose clip has not been cut yet renders as text
 * rather than as a broken <video>.
 */
import { PMAP, projectHref, projectSlug, type Project } from '../data/projects';
import { projectMedia, hasAsset, captionTrack } from '../lib/projectMedia';
import type { RosterSection, RosterItem } from '../data/seereality';

interface Props { section: RosterSection }
const { section } = Astro.props;

type Resolved = {
    item: RosterItem;
    href: string | null;
    video: string | null;
    poster: string | null;
    captions: string | null;
    /**
     * Whether this cell's video is footage or decoration.
     *
     * A clip is a piece of the real capture with its own audio, so it gets a
     * player: play, pause, volume, fullscreen. A project's card preview is a
     * silent fifteen-second loop that exists to make the card move, and the
     * cell already links to the page where that project's full video plays
     * with sound — a volume slider on a track that has no audio is a control
     * that does nothing.
     */
    playable: boolean;
};

function resolve(item: RosterItem): Resolved {
    const target: Project | undefined = item.project ? PMAP[item.project] : undefined;
    const href = target ? projectHref(target.name) : null;

    // An explicit clip wins over the project's own card preview: where an item
    // sets both, the clip is a moment chosen for this grid and the preview is
    // the generic one from the card.
    if (item.clip && hasAsset(item.clip)) {
        const poster = item.clip.replace(/\.mp4$/, '.jpg');
        return {
            item, href, video: item.clip,
            poster: hasAsset(poster) ? poster : null,
            captions: captionTrack(item.clip),
            playable: true,
        };
    }
    if (item.still && hasAsset(item.still)) {
        return { item, href, video: null, poster: item.still, captions: null, playable: false };
    }
    if (target) {
        const media = projectMedia(target.cover, false);
        return {
            item, href, video: media.preview, poster: media.poster,
            captions: null, playable: false,
        };
    }
    return { item, href, video: null, poster: null, captions: null, playable: false };
}

const items = section.items.map(resolve);
---

<section class="band" aria-labelledby={`r-${section.id}`}>
    <div class="band-grid">
        <p class="label band-label" id={`r-${section.id}`}>{section.label}</p>
        <div>
            {section.note && <p class="roster-note">{section.note}</p>}
            <div class="roster">
                {items.map(({ item, href, video, poster, captions, playable }) => (
                    <article class="rcard">
                        {(video || poster) && (
                            <div class="rcard-media" transition:name={href ? `m-${projectSlug(item.name)}` : undefined}>
                                {video ? (
                                    <video
                                        src={video}
                                        poster={poster ?? undefined}
                                        autoplay muted loop playsinline preload="metadata"
                                        controls={playable}
                                        data-hero-video
                                        aria-label={playable ? `${item.name} — clip` : `${item.name} — looping preview`}>
                                        {captions && (
                                            <track
                                                kind="captions"
                                                src={captions}
                                                srclang="en"
                                                label="English (auto)"
                                            />
                                        )}
                                    </video>
                                ) : (
                                    <img src={poster!} alt={`${item.name} — still`} loading="lazy" decoding="async" />
                                )}
                            </div>
                        )}
                        <h3 class="rcard-name">
                            {href ? <a href={href} transition:name={`t-${projectSlug(item.name)}`}>{item.name}</a> : item.name}
                        </h3>
                        {item.meta && <p class="rcard-meta">{item.meta}</p>}
                        <p class="rcard-body">{item.body}</p>
                        {(href || item.link) && (
                            <p class="rcard-links">
                                {href && <a href={href}>See the project &rarr;</a>}
                                {item.link && (
                                    <a href={item.link.url} target="_blank" rel="noopener">{item.link.label} &#8599;</a>
                                )}
                            </p>
                        )}
                    </article>
                ))}
            </div>
        </div>
    </div>
</section>
