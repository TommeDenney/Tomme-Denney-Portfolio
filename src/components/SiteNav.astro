---
/**
 * The bar. Sticky, hairline-ruled, and the same on every page — v1 rewrote its
 * own nav in JS whenever the mode changed, which meant two copies of the markup
 * that had to agree by hand.
 */
interface Props { current?: 'home' | 'work' | 'about' | 'photography' }
// Photography is reached from /work rather than the top bar: four peer links
// gave it equal billing with the design work, which is the opposite of the
// point when the whole site is a repositioning.
const { current } = Astro.props;
---
<a class="skip" href="#main">Skip to content</a>
<nav class="nav" transition:name="site-nav" transition:animate="none">
    <a class="nav-mark" href="/">
        {/* The monogram is a mask rather than an image, so it is drawn in the
            theme's own text colour and flips with it — the source art is black
            on paper, which would have needed a second file and a swap. */}
        <span class="nav-logo" aria-hidden="true"></span>
        Tomme Denney
    </a>
    <ul class="nav-links">
        {/* The wordmark already goes home, but a named link is what a visitor
            looks for, and it keeps the row readable as a set. */}
        <li><a href="/" aria-current={current === 'home' ? 'page' : undefined}>Home</a></li>
        <li>
            <a href="/work" aria-current={current === 'work' || current === 'photography' ? 'page' : undefined}>Work</a>
        </li>
        <li><a href="/about" aria-current={current === 'about' ? 'page' : undefined}>About</a></li>
        <li>
            {/* A swatch of the theme it switches to. "Ink" as a word told a
                visitor nothing about what the button did. */}
            <button class="theme-btn" id="theme-btn" type="button">
                <span class="theme-dot" aria-hidden="true"></span>
                <span class="skip" id="theme-label">Switch theme</span>
            </button>
        </li>
    </ul>
</nav>
<script is:inline>
    /*
     * Wired on astro:page-load rather than on parse, because client-side
     * navigation hands this component a brand new button element: a listener
     * bound once to the node that existed at first paint would stop working
     * the moment somebody visited a second page. page-load fires on the first
     * load and after every swap, and the per-element flag makes a second call
     * on the same button a no-op.
     */
    (function () {
        function init() {
            var btn = document.getElementById('theme-btn');
            if (!btn || btn.dataset.wired) return;
            btn.dataset.wired = '1';

            // Persisted, unlike v1 — a palette that resets on every navigation
            // is not a preference, it is a toggle that forgets.
            var label = document.getElementById('theme-label');
            function sync() {
                var toWheat = document.documentElement.dataset.theme === 'ink';
                btn.setAttribute('aria-label', toWheat ? 'Switch to the Wheat theme' : 'Switch to the Ink theme');
                label.textContent = toWheat ? 'Switch to Wheat' : 'Switch to Ink';
            }
            sync();
            btn.addEventListener('click', function () {
                var next = document.documentElement.dataset.theme === 'ink' ? 'wheat' : 'ink';
                document.documentElement.dataset.theme = next;
                localStorage.setItem('theme', next);
                sync();
            });
        }

        init();
        if (!window.__navWired) {
            window.__navWired = true;
            document.addEventListener('astro:page-load', init);
        }
    })();
</script>
