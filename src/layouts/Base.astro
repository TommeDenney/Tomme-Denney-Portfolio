---
/**
 * The page shell.
 *
 * v1 inlined head.js here so the markup's onerror/imgFallback attributes could
 * find it during parse. The new pages resolve their media at build time and
 * emit only tags that point at files which exist, so that chain is gone.
 */
import '../styles/global.css';

interface Props {
    title?: string;
    description?: string;
    /** Site-root-absolute path of this page. Defaults to the site root. */
    path?: string;
    /** Site-root-absolute path or absolute URL of the share image, if any. */
    image?: string;
    ogType?: string;
    /** Extra class on <body>, for per-page overrides of the global styles. */
    bodyClass?: string;
}

const {
    title = 'Tomme Denney',
    description = 'XR developer and photographer in Boston, Massachusetts. Extended reality, Gaussian splatting, and game design.',
    path = '/',
    image,
    ogType = 'website',
    bodyClass,
} = Astro.props;

// The canonical used to be hardcoded to Astro.site, which was right while
// index.astro was the only route and points every project page at the
// homepage now that they exist.
const canonical = new URL(path, Astro.site).href;
const ogImage = image ? new URL(image, Astro.site).href : undefined;
---

<!DOCTYPE html>
<html lang="en" data-theme="ink">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1" />
        <title>{title}</title>
        <meta name="description" content={description} />
        <link rel="canonical" href={canonical} />

        <meta property="og:type" content={ogType} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:site_name" content="Tomme Denney" />
        {ogImage && <meta property="og:image" content={ogImage} />}
        <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
        <meta name="twitter:title" content={title} />
        <meta name="twitter:description" content={description} />
        {ogImage && <meta name="twitter:image" content={ogImage} />}

        <link rel="preconnect" href="https://fonts.googleapis.com" />
        <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
        {/* Fraunces is the change of character: a variable serif with the
            optical-size axis wound up reads as a printed archive, where Barlow
            Condensed read as industrial signage. Barlow stays for text and UI. */}
        <link
            href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400..700&family=Barlow:wght@400;500;600;700&display=swap"
            rel="stylesheet"
        />

        {/* Ink is the default and is already on <html>, so there is nothing to
            do unless the visitor chose wheat. Set before first paint either
            way, so the page never flashes the theme it is about to leave. */}
        <script is:inline>
            if (localStorage.getItem('theme') === 'wheat') document.documentElement.dataset.theme = 'wheat';
        </script>
    </head>
    <body class={bodyClass}>
        <slot />
    </body>
</html>
