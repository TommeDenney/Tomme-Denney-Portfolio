---
/**
 * Home.
 *
 * v1's homepage was a spring-loaded hero card stack, a ticker, an
 * auto-advancing carousel and four in-page sections, all driven by a 700-line
 * script — and none of it said what Tomme does. This states the positioning,
 * hands off to one case study, and lists the rest as an index. No carousel, no
 * ticker, no overlay: every destination is a real URL.
 */
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import VideoAutoplay from '../components/VideoAutoplay.astro';
import { PROJECTS, PMAP, projectHref, projectSlug, projectKind, KIND_LABEL } from '../data/projects';
import { projectMedia } from '../lib/projectMedia';

// Three featured projects, in this order on purpose. See Reality first: it is
// the only professional, deployed, multi-year body of work here, and it is the
// answer to the first question a hiring reader has. Then the two pieces that
// argue for something — that spatial media can hold a memory, and that a
// service can hand authority to the person usually being helped.
const LEADS = ['seereality', 'genexr', 'spark'];
const leads = LEADS.map((id) => ({ p: PMAP[id], media: projectMedia(PMAP[id].cover, false) }));

// The index under the leads: the work worth a recruiter's next click, in the
// order it should be read rather than by date.
const card = (id: string) => ({ p: PMAP[id], media: projectMedia(PMAP[id].cover, false) });

// The deployments come directly under the featured three, because the argument
// See Reality makes is plural. One card says "client work"; four client names
// with footage of the thing running in four different cities says the rest of
// it. These are the four with capture reels — Ride Solar and Venice City Tours
// are on the See Reality page and on /work.
const DEPLOYMENTS = ['relive1776', 'showmeitaly', 'lexington', 'nashvilleadventures'];

// Then the written-up work, then work that speaks for itself. Badges carry the
// tier inside each row.
const WRITTEN = ['recollection', 'buddyrun', 'haptidraw', 'iamyou'];
const PROJECTS_ROW = ['bofum', 'wallace', 'unforgottenstories', 'greatvendingmachine'];
const written = WRITTEN.map(card);
const deployments = DEPLOYMENTS.map(card);
const projectsRow = PROJECTS_ROW.map(card);

// The social card, pinned rather than taken from the first lead: See Reality's
// poster is a logo badge, and a logo unfurls in Slack as a sticker rather than
// as work. Inhabiting Memory's is a photograph of the thing running.
const socialImage = PMAP.genexr.cover;
---

<Base
    title="Tomme Denney — Spatial & Immersive Product Designer"
    description="Spatial and immersive product designer who prototypes. MS Extended Reality with a concentration in Human-Computer Interaction, BFA Game Design — Northeastern University."
    path="/"
    image={socialImage}
>
    <SiteNav current="home" />

    <main id="main">
        {/* No masthead: the introduction lives on /about now, and the
            homepage opens on the work itself. */}
        <section class="band strip leads-band leads-first" aria-labelledby="lead-h">
            <p class="label" id="lead-h" style="margin-bottom:30px">Featured projects</p>
            <div class="leads">
                {leads.map(({ p: lead, media }) => (
                    <a class="feature" href={projectHref(lead.name)}>
                        <div class="feature-media" transition:name={`m-${projectSlug(lead.name)}`}>
                            {media.preview ? (
                                <video
                                    src={media.preview}
                                    poster={media.poster ?? undefined}
                                    autoplay muted loop playsinline preload="metadata"
                                    data-hero-video
                                    aria-label={`${lead.name} — looping preview`}></video>
                            ) : media.poster ? (
                                <img src={media.poster} alt={`${lead.name} — cover`} />
                            ) : null}
                            <span class="index-kind" data-kind={projectKind(lead)}>
                                {KIND_LABEL[projectKind(lead)]}
                            </span>
                        </div>
                        <div class="feature-body">
                            <h2 class="display lead-title" transition:name={`t-${projectSlug(lead.name)}`}>{lead.name}</h2>
                            <p class="label lead-cta">{projectKind(lead) === 'project' ? 'See the work' : 'Read it'}</p>
                        </div>
                        <p class="lead-cap">{lead.caption}</p>
                    </a>
                ))}
            </div>
        </section>

        {/* Full-bleed rows: the shell's 1440px cap would leave four cards
            narrower than the two leads above them, which reads as a downgrade
            rather than a different section. These set their own gutters. */}
        <section class="band strip" aria-labelledby="dep-h">
            <p class="label" id="dep-h" style="margin-bottom:28px">See Reality deployments</p>
            <div class="strip-grid">
                {deployments.map(({ p: item, media }) => (
                    <a class="feature" href={projectHref(item.name)}>
                        <div class="feature-media" transition:name={`m-${projectSlug(item.name)}`}>
                            {media.preview ? (
                                <video
                                    src={media.preview}
                                    poster={media.poster ?? undefined}
                                    autoplay muted loop playsinline preload="metadata"
                                    data-hero-video
                                    aria-label={`${item.name} — looping preview`}></video>
                            ) : media.poster ? (
                                <img src={media.poster} alt={`${item.name} — cover`} loading="lazy" decoding="async" />
                            ) : null}
                        </div>
                        <div class="feature-body">
                            <h3 class="display strip-title" transition:name={`t-${projectSlug(item.name)}`}>{item.name}</h3>
                        </div>
                        <p class="lead-cap">{item.caption}</p>
                    </a>
                ))}
            </div>
            <p style="margin-top:44px">
                <a class="btn" href={projectHref(PMAP.seereality.name)}>All the See Reality work</a>
            </p>
        </section>

        <section class="band strip" aria-labelledby="cs-h">
            <p class="label" id="cs-h" style="margin-bottom:28px">Case studies</p>
            <div class="strip-grid">
                {written.map(({ p: item, media }) => (
                    <a class="feature" href={projectHref(item.name)}>
                        <div class="feature-media" transition:name={`m-${projectSlug(item.name)}`}>
                            {media.preview ? (
                                <video
                                    src={media.preview}
                                    poster={media.poster ?? undefined}
                                    autoplay muted loop playsinline preload="metadata"
                                    data-hero-video
                                    aria-label={`${item.name} — looping preview`}></video>
                            ) : media.poster ? (
                                <img src={media.poster} alt={`${item.name} — cover`} loading="lazy" decoding="async" />
                            ) : null}
                            <span class="index-kind" data-kind={projectKind(item)}>
                                {KIND_LABEL[projectKind(item)]}
                            </span>
                        </div>
                        <div class="feature-body">
                            <h3 class="display strip-title" transition:name={`t-${projectSlug(item.name)}`}>{item.name}</h3>
                        </div>
                        <p class="lead-cap">{item.caption}</p>
                    </a>
                ))}
            </div>
        </section>

        <section class="band strip" aria-labelledby="pr-h">
            <p class="label" id="pr-h" style="margin-bottom:28px">Projects</p>
            <div class="strip-grid">
                {projectsRow.map(({ p: item, media }) => (
                    <a class="feature" href={projectHref(item.name)}>
                        <div class="feature-media" transition:name={`m-${projectSlug(item.name)}`}>
                            {media.preview ? (
                                <video
                                    src={media.preview}
                                    poster={media.poster ?? undefined}
                                    autoplay muted loop playsinline preload="metadata"
                                    data-hero-video
                                    aria-label={`${item.name} — looping preview`}></video>
                            ) : media.poster ? (
                                <img src={media.poster} alt={`${item.name} — cover`} loading="lazy" decoding="async" />
                            ) : null}
                        </div>
                        <div class="feature-body">
                            <h3 class="display strip-title" transition:name={`t-${projectSlug(item.name)}`}>{item.name}</h3>
                        </div>
                        <p class="lead-cap">{item.caption}</p>
                    </a>
                ))}
            </div>
            <p style="margin-top:52px">
                <a class="btn" href="/work">All {PROJECTS.length} projects</a>
            </p>
        </section>
    </main>

    <SiteFooter />

    <VideoAutoplay />
</Base>
