---
/**
 * Home.
 *
 * v1's homepage was a spring-loaded hero card stack, a ticker, an
 * auto-advancing carousel and four in-page sections, all driven by a 700-line
 * script — and none of it said what Tomme does. This states the positioning,
 * hands off to one case study, and lists the rest as an index. No carousel, no
 * ticker, no overlay: every destination is a real URL.
 */
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { PROJECTS, PMAP, projectHref, projectKind, KIND_LABEL } from '../data/projects';
import { projectMedia } from '../lib/projectMedia';

// Two leads rather than one. Both carry a full case study and they argue for
// different things — one that spatial media can hold a memory, one that a
// service can hand authority to the person usually being helped — so putting
// either second would undersell it.
const LEADS = ['genexr', 'spark'];
const leads = LEADS.map((id) => ({ p: PMAP[id], media: projectMedia(PMAP[id].cover, false) }));

// The index under the leads: the work worth a recruiter's next click, in the
// order it should be read rather than by date.
const card = (id: string) => ({ p: PMAP[id], media: projectMedia(PMAP[id].cover, false) });

// The two leads, then the rest of the written-up work, then work that speaks
// for itself. Badges carry the tier inside each row.
const WRITTEN = ['recollection', 'buddyrun', 'haptidraw', 'iamyou'];
const PROJECTS_ROW = ['seereality', 'bofum', 'wallace', 'unforgottenstories'];
const written = WRITTEN.map(card);
const projectsRow = PROJECTS_ROW.map(card);
---

<Base
    title="Tomme Denney — Spatial & Immersive Product Designer"
    description="Spatial and immersive product designer who prototypes. MS Extended Reality with a concentration in Human-Computer Interaction, BFA Game Design — Northeastern University."
    path="/"
    image={leads[0].media.poster ?? leads[0].p.cover}
>
    <SiteNav />

    <main id="main">
        <header class="shell mast">
            <p class="label">Tomme Denney &middot; Boston, Massachusetts</p>
            <h1 class="display">
                I design experiences you <span class="mast-accent">enter</span>, not ones you look at.
            </h1>
            <div class="mast-body">
                <p class="lede">
                    Spatial and immersive product designer — and enough of a builder to
                    test an idea in a headset instead of arguing about it in a deck.
                </p>
                <div class="prose muted">
                    <p>
                        MS in Extended Reality with a concentration in Human-Computer
                        Interaction, and a BFA in Game Design, both from Northeastern
                        University. Several years building XR for real clients.
                    </p>
                    <p>
                        I treat comfort as an accessibility problem rather than a polish
                        pass: locomotion, session length, play space and the person who
                        has never worn a headset are design questions from the first sketch.
                    </p>
                </div>
            </div>
        </header>

        <section class="band strip leads-band" aria-labelledby="lead-h">
            <p class="label" id="lead-h" style="margin-bottom:30px">Lead case studies</p>
            <div class="leads">
                {leads.map(({ p: lead, media }) => (
                    <a class="feature" href={projectHref(lead.name)}>
                        <div class="feature-media">
                            {media.preview ? (
                                <video
                                    src={media.preview}
                                    poster={media.poster ?? undefined}
                                    autoplay muted loop playsinline preload="metadata"
                                    data-hero-video
                                    aria-label={`${lead.name} — looping preview`}></video>
                            ) : media.poster ? (
                                <img src={media.poster} alt={`${lead.name} — cover`} />
                            ) : null}
                            <span class="index-kind" data-kind={projectKind(lead)}>
                                {KIND_LABEL[projectKind(lead)]}
                            </span>
                        </div>
                        <div class="feature-body">
                            <h2 class="display lead-title">{lead.name}</h2>
                            <p class="label">Read it &rarr;</p>
                        </div>
                        <p class="lead-cap">{lead.caption}</p>
                    </a>
                ))}
            </div>
        </section>

        {/* Full-bleed rows: the shell's 1440px cap would leave four cards
            narrower than the two leads above them, which reads as a downgrade
            rather than a different section. These set their own gutters. */}
        <section class="band strip" aria-labelledby="cs-h">
            <p class="label" id="cs-h" style="margin-bottom:28px">Case studies</p>
            <div class="strip-grid">
                {written.map(({ p: item, media }) => (
                    <a class="feature" href={projectHref(item.name)}>
                        <div class="feature-media">
                            {media.preview ? (
                                <video
                                    src={media.preview}
                                    poster={media.poster ?? undefined}
                                    autoplay muted loop playsinline preload="metadata"
                                    data-hero-video
                                    aria-label={`${item.name} — looping preview`}></video>
                            ) : media.poster ? (
                                <img src={media.poster} alt={`${item.name} — cover`} loading="lazy" decoding="async" />
                            ) : null}
                            <span class="index-kind" data-kind={projectKind(item)}>
                                {KIND_LABEL[projectKind(item)]}
                            </span>
                        </div>
                        <div class="feature-body">
                            <h3 class="display strip-title">{item.name}</h3>
                        </div>
                        <p class="lead-cap">{item.caption}</p>
                    </a>
                ))}
            </div>
        </section>

        <section class="band strip" aria-labelledby="pr-h">
            <p class="label" id="pr-h" style="margin-bottom:28px">Projects</p>
            <div class="strip-grid">
                {projectsRow.map(({ p: item, media }) => (
                    <a class="feature" href={projectHref(item.name)}>
                        <div class="feature-media">
                            {media.preview ? (
                                <video
                                    src={media.preview}
                                    poster={media.poster ?? undefined}
                                    autoplay muted loop playsinline preload="metadata"
                                    data-hero-video
                                    aria-label={`${item.name} — looping preview`}></video>
                            ) : media.poster ? (
                                <img src={media.poster} alt={`${item.name} — cover`} loading="lazy" decoding="async" />
                            ) : null}
                        </div>
                        <div class="feature-body">
                            <h3 class="display strip-title">{item.name}</h3>
                        </div>
                        <p class="lead-cap">{item.caption}</p>
                    </a>
                ))}
            </div>
            <p style="margin-top:52px">
                <a class="btn" href="/work">All {PROJECTS.length} projects &rarr;</a>
            </p>
        </section>
    </main>

    <SiteFooter />

    <script is:inline>
        (function () {
            var vids = document.querySelectorAll('video[data-hero-video]');

            if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                vids.forEach(function (v) { v.removeAttribute('autoplay'); v.pause(); });
                return;
            }

            /* Six autoplaying clips would pull tens of megabytes before anyone
               scrolled. They keep the autoplay attribute so whatever is on
               screen at load starts immediately; anything off screen is paused
               until it arrives. */
            if (!('IntersectionObserver' in window)) return;
            var io = new IntersectionObserver(function (entries) {
                entries.forEach(function (e) {
                    if (e.isIntersecting) {
                        var play = e.target.play();
                        if (play && play.catch) play.catch(function () {});
                    } else {
                        e.target.pause();
                    }
                });
            }, { rootMargin: '200px' });
            vids.forEach(function (v) { io.observe(v); });
        })();
    </script>
</Base>
