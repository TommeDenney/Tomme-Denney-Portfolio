---
/**
 * Home.
 *
 * v1's homepage was a spring-loaded hero card stack, a ticker, an
 * auto-advancing carousel and four in-page sections, all driven by a 700-line
 * script — and none of it said what Tomme does. This states the positioning,
 * hands off to one case study, and lists the rest as an index. No carousel, no
 * ticker, no overlay: every destination is a real URL.
 */
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { PROJECTS, PMAP, projectHref, projectDisciplines } from '../data/projects';
import { projectMedia } from '../lib/projectMedia';

const lead = PMAP.genexr;
const leadMedia = projectMedia(lead.cover, false);

// The index under the lead: the work worth a recruiter's next click, in the
// order it should be read rather than by date.
const SELECTED = ['seereality', 'haptidraw', 'bofum', 'iamyou', 'wallace', 'unforgottenstories'];
const selected = SELECTED.map((id) => PMAP[id]).filter(Boolean);
---

<Base
    title="Tomme Denney — Spatial & Immersive Product Designer"
    description="Spatial and immersive product designer who prototypes. MS Extended Reality with a concentration in Human-Computer Interaction, BFA Game Design — Northeastern University."
    path="/"
    image={leadMedia.poster ?? lead.cover}
>
    <SiteNav />

    <main id="main">
        <header class="shell mast">
            <p class="label">Tomme Denney &middot; Boston, Massachusetts</p>
            <h1 class="display">
                I design experiences you <span class="mast-accent">enter</span>, not ones you look at.
            </h1>
            <div class="mast-body">
                <p class="lede">
                    Spatial and immersive product designer — and enough of a builder to
                    test an idea in a headset instead of arguing about it in a deck.
                </p>
                <div class="prose muted">
                    <p>
                        MS in Extended Reality with a concentration in Human-Computer
                        Interaction, and a BFA in Game Design, both from Northeastern
                        University. Several years building XR for real clients.
                    </p>
                    <p>
                        I treat comfort as an accessibility problem rather than a polish
                        pass: locomotion, session length, play space and the person who
                        has never worn a headset are design questions from the first sketch.
                    </p>
                </div>
            </div>
        </header>

        <section class="shell band" aria-labelledby="lead-h">
            <div class="band-grid">
                <p class="label band-label">Lead case study</p>
                <div>
                    <a class="feature" href={projectHref(lead.name)}>
                        <div class="feature-media">
                            {leadMedia.video ? (
                                <video
                                    src={leadMedia.video}
                                    poster={leadMedia.poster ?? undefined}
                                    autoplay muted loop playsinline preload="metadata"
                                    data-hero-video
                                    aria-label={`${lead.name} — looping preview`}></video>
                            ) : leadMedia.poster ? (
                                <img src={leadMedia.poster} alt={`${lead.name} — cover`} />
                            ) : null}
                        </div>
                        <div class="feature-body">
                            <h2 class="display" id="lead-h" style="font-size:clamp(30px,4.2vw,58px)">
                                {lead.name}
                            </h2>
                            <p class="label">Read the case study &rarr;</p>
                        </div>
                    </a>
                    <p class="prose" style="margin-top:22px">{lead.caption}</p>
                </div>
            </div>
        </section>

        <section class="shell band" aria-labelledby="sel-h">
            <div class="band-grid">
                <p class="label band-label" id="sel-h">Selected work</p>
                <div>
                    <ol class="index">
                        {selected.map((p, i) => {
                            const media = projectMedia(p.cover, false);
                            return (
                                <li class="index-row">
                                    <a
                                        class="index-link"
                                        href={projectHref(p.name)}
                                        data-peek={media.poster ?? ''}
                                    >
                                        <span class="index-num">{String(i + 1).padStart(2, '0')}</span>
                                        <span>
                                            <span class="index-name">{p.name}</span>
                                            <span class="index-meta">{projectDisciplines(p).join(' · ')}</span>
                                        </span>
                                        <span class="index-kind" data-kind={p.caseStudy ? 'case' : 'project'}>
                                            {p.caseStudy ? 'Case study' : 'Project'}
                                        </span>
                                        {media.poster && (
                                            <span class="index-thumb">
                                                <img src={media.poster} alt="" loading="lazy" decoding="async" />
                                            </span>
                                        )}
                                    </a>
                                </li>
                            );
                        })}
                    </ol>
                    <p style="margin-top:36px">
                        <a class="btn" href="/work">All {PROJECTS.length} projects &rarr;</a>
                    </p>
                </div>
            </div>
        </section>
    </main>

    <div class="peek" id="peek" aria-hidden="true"><img src="" alt="" /></div>
    <SiteFooter />

    <script is:inline src="/peek.js" defer></script>
    <script is:inline>
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.querySelectorAll('video[data-hero-video]').forEach(function (v) {
                v.removeAttribute('autoplay');
                v.pause();
            });
        }
    </script>
</Base>
