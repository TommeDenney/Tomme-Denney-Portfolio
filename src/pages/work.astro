---
/**
 * The work index.
 *
 * A contents page rather than a wall of tiles: numbered rows on hairline
 * rules, with the still following the pointer. Filtering is a hidden attribute
 * toggle, so every row stays in the HTML and is crawlable whichever filter is
 * showing — 18 rows does not justify shipping a framework.
 */
import Base from '../layouts/Base.astro';
import SiteNav from '../components/SiteNav.astro';
import SiteFooter from '../components/SiteFooter.astro';
import { PROJECTS, DISCIPLINES, projectDisciplines, projectHref } from '../data/projects';
import { projectMedia } from '../lib/projectMedia';

const rows = PROJECTS.map((p) => ({
    p,
    href: projectHref(p.name),
    disciplines: projectDisciplines(p),
    media: projectMedia(p.cover, false),
}));

const counts = Object.fromEntries(
    DISCIPLINES.map((d) => [d, rows.filter((r) => r.disciplines.includes(d)).length]),
);
---

<Base
    title="Work — Tomme Denney"
    description="Spatial and immersive design, games, and design research by Tomme Denney."
    path="/work"
>
    <SiteNav current="work" />

    <main id="main" class="shell">
        <header class="mast">
            <p class="label">Index</p>
            <h1 class="display">Work</h1>
            <p class="lede" style="margin-top:26px">
                Spatial work first, then games, then the research that tested it.
                Case studies carry the reasoning; projects carry the craft.
            </p>
        </header>

        <div class="filters" role="group" aria-label="Filter by discipline">
            <button class="filter on" data-filter="all" aria-pressed="true">
                All <span class="filter-n">{rows.length}</span>
            </button>
            {DISCIPLINES.map((d) => (
                <button class="filter" data-filter={d} aria-pressed="false">
                    {d} <span class="filter-n">{counts[d]}</span>
                </button>
            ))}
        </div>

        <ol class="index" id="index">
            {rows.map(({ p, href, disciplines, media }, i) => (
                <li class="index-row" data-disciplines={disciplines.join('|')}>
                    <a class="index-link" href={href} data-peek={media.poster ?? ''}>
                        <span class="index-num">{String(i + 1).padStart(2, '0')}</span>
                        <span>
                            <span class="index-name">{p.name}</span>
                            <span class="index-meta">{p.cat}</span>
                        </span>
                        <span class="index-kind" data-kind={p.caseStudy ? 'case' : 'project'}>
                            {p.caseStudy ? 'Case study' : 'Project'}
                        </span>
                        {media.poster && (
                            <span class="index-thumb">
                                <img src={media.poster} alt="" loading="lazy" decoding="async" />
                            </span>
                        )}
                    </a>
                </li>
            ))}
        </ol>

        <p class="muted" id="empty" hidden style="padding:48px 0">Nothing in that discipline yet.</p>

        <section class="band">
            <div class="band-grid">
                <p class="label band-label">Also</p>
                <div>
                    <h2 class="display" style="font-size:clamp(26px,3.2vw,40px)">Photography</h2>
                    <p class="prose muted" style="margin-top:12px">
                        Real-estate and spatial capture — stills, and the scanning work
                        the XR projects are built on.
                    </p>
                    <p style="margin-top:22px"><a class="btn" href="/work/photography">View photographs &rarr;</a></p>
                </div>
            </div>
        </section>
    </main>

    <div class="peek" id="peek" aria-hidden="true"><img src="" alt="" /></div>
    <SiteFooter />

    <script is:inline src="/peek.js" defer></script>
    <script is:inline>
        (function () {
            var buttons = document.querySelectorAll('.filter');
            var rows = document.querySelectorAll('#index .index-row');
            var empty = document.getElementById('empty');

            buttons.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    var f = btn.dataset.filter;
                    buttons.forEach(function (b) {
                        b.classList.toggle('on', b === btn);
                        b.setAttribute('aria-pressed', b === btn ? 'true' : 'false');
                    });
                    var shown = 0;
                    rows.forEach(function (row) {
                        var list = (row.dataset.disciplines || '').split('|');
                        var show = f === 'all' || list.indexOf(f) !== -1;
                        row.hidden = !show;
                        if (show) shown++;
                    });
                    empty.hidden = shown > 0;
                });
            });
        })();
    </script>
</Base>
