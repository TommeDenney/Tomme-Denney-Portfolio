---
/**
 * The work index.
 *
 * / is a pitch and hands off to one case study; this is the browsable wall.
 * Filtering is a class toggle on the grid rather than a re-render: 18 cards is
 * not enough work to justify shipping a framework, and the whole grid stays in
 * the HTML so it is all crawlable regardless of which filter is active.
 */
import Base from '../layouts/Base.astro';
import {
    PROJECTS, DISCIPLINES, projectDisciplines, projectHref,
} from '../data/projects';
import { projectMedia } from '../lib/projectMedia';

const cards = PROJECTS.map((p) => ({
    p,
    href: projectHref(p.name),
    disciplines: projectDisciplines(p),
    media: projectMedia(p.cover, false),
}));

const counts = Object.fromEntries(
    DISCIPLINES.map((d) => [d, cards.filter((c) => c.disciplines.includes(d)).length]),
);
---

<Base
    title="Work — Tomme Denney"
    description="Spatial and immersive design, games, interface work and design research by Tomme Denney."
    path="/work"
>
    <nav class="pp-nav">
        <a class="logo" href="/">Tomme Denney</a>
        <a class="back-btn" href="/">All Work</a>
    </nav>

    <main class="wx">
        <header class="wx-head">
            <p class="label">Selected work</p>
            <h1 class="wx-title">Work</h1>
            <p class="wx-sub">
                Spatial and immersive design first, then games, interface work, and
                the research that tested it. Case studies carry the reasoning;
                projects carry the craft.
            </p>
        </header>

        <div class="wx-filters" role="group" aria-label="Filter by discipline">
            <button class="wx-filter is-on" data-filter="all" aria-pressed="true">
                All <span class="wx-count">{cards.length}</span>
            </button>
            {DISCIPLINES.map((d) => (
                <button class="wx-filter" data-filter={d} aria-pressed="false">
                    {d} <span class="wx-count">{counts[d]}</span>
                </button>
            ))}
        </div>

        <div class="wx-grid" id="wx-grid">
            {cards.map(({ p, href, disciplines, media }) => (
                <article class="wx-card" data-disciplines={disciplines.join('|')}>
                    <a class="wx-link" href={href}>
                        <div class="wx-thumb">
                            <div class="wx-thumb-bg" style={`background:${p.bg}`}></div>
                            {media.poster && (
                                <img src={media.poster} alt={`${p.name} — cover`} loading="lazy" decoding="async" />
                            )}
                            <span class="wx-kind">{p.caseStudy ? 'Case study' : 'Project'}</span>
                        </div>
                        <h2 class="wx-name">{p.name}</h2>
                        <p class="wx-cat">{p.cat}</p>
                        {p.caption && <p class="wx-cap">{p.caption}</p>}
                        <span class="wx-more">{p.caseStudy ? 'Read the case study' : 'View project'} →</span>
                    </a>
                </article>
            ))}
        </div>

        <p class="wx-empty" id="wx-empty" hidden>Nothing in that discipline yet.</p>
    </main>

    <script is:inline>
        (function () {
            var grid = document.getElementById('wx-grid');
            var empty = document.getElementById('wx-empty');
            var buttons = document.querySelectorAll('.wx-filter');

            function apply(filter) {
                var shown = 0;
                grid.querySelectorAll('.wx-card').forEach(function (card) {
                    var list = (card.dataset.disciplines || '').split('|');
                    var show = filter === 'all' || list.indexOf(filter) !== -1;
                    card.hidden = !show;
                    if (show) shown++;
                });
                empty.hidden = shown > 0;
            }

            buttons.forEach(function (btn) {
                btn.addEventListener('click', function () {
                    buttons.forEach(function (b) {
                        b.classList.remove('is-on');
                        b.setAttribute('aria-pressed', 'false');
                    });
                    btn.classList.add('is-on');
                    btn.setAttribute('aria-pressed', 'true');
                    apply(btn.dataset.filter);
                });
            });
        })();
    </script>
</Base>
