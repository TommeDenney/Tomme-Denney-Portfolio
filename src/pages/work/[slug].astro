---
/**
 * A project's own page, one per entry in PROJECTS.
 *
 * The overlay views on / are still the way the site is browsed, but overlay
 * state has no URL: nothing about the address changes when a project opens, so
 * a project could not be linked, shared or indexed. These routes exist so it
 * can be. They read the same PROJECTS objects the overlay does — nothing here
 * is a second copy of the content — and index.astro is untouched.
 *
 * Where a project has a `caseStudy`, the long-form Markdown in case-studies/
 * replaces the short `desc` rather than sitting next to it, so the prose has
 * exactly one home.
 */
import Base from '../../layouts/Base.astro';
import SiteNav from '../../components/SiteNav.astro';
import SiteFooter from '../../components/SiteFooter.astro';
import {
    PROJECTS, PROJECT_EXTERNAL_SITES, PROJECT_EMBEDS,
    projectSlug, projectHref, projectDisciplines, type Project,
} from '../../data/projects';
import { projectMedia, hasAsset } from '../../lib/projectMedia';
import { assetUrl } from '../../lib/assets';

export function getStaticPaths() {
    return PROJECTS.map((project) => ({
        params: { slug: projectSlug(project.name) },
        props: { project },
    }));
}

interface Props { project: Project }
const { project: p } = Astro.props;

const media = projectMedia(p.cover, p.galleryImages !== false);
const ext = PROJECT_EXTERNAL_SITES[p.id];
const embed = PROJECT_EMBEDS[p.id];

/**
 * Astro runs Markdown anywhere in the project through its normal pipeline, so
 * the case studies can stay at the repo root next to the drafts they came from
 * instead of being copied into src/. remarkStripNeedsInput has already removed
 * the author's open questions by the time `Content` renders — see
 * scripts/remark-strip-needs-input.mjs.
 */
const caseStudies = import.meta.glob<{ Content: any }>(
    '../../../case-studies/*.md',
    { eager: true },
);

const caseStudy = p.caseStudy
    ? caseStudies[`../../../case-studies/${p.caseStudy}.md`]
    : undefined;

const Content = caseStudy?.Content;

/**
 * The evidence slots from the asset list at the end of the case study, in
 * priority order. Each is emitted only if the file is actually on disk, which
 * is what keeps an unfilled slot from becoming a broken <video> on a live
 * page. Video first: the argument is about what happens when the visitor
 * moves, and a still cannot carry that.
 */
/**
 * A portrait screen recording, shown alongside its notes rather than as a
 * full-width hero. An iPhone capture is 588x1280; stretched across the top it
 * would be four fifths letterbox, and shrunk to fit it would be unreadable.
 */
type Demo = { src: string; poster?: string; caption: string; notes: string[] };
const DEMOS: Record<string, Demo> = {
    'buddy-run': {
        src: '/case-studies/buddy-run/app-demo.mp4',
        poster: '/case-studies/buddy-run/app-demo.jpg',
        caption: 'Three minutes through the app: intake, baseline run, sprint, and the live run screen.',
        notes: [
            'The whole screen is the readout. Background colour carries the heart-rate zone, so the state is legible at a glance mid-stride rather than needing a number read off a chart.',
            'The zone is named in words — "Above Target", "Below Target", "run at a pace where you can hold a conversation" — because a runner at effort has no attention spare for arithmetic.',
            'Target cadence has plus and minus controls and the tempo guide has an off switch. The algorithm proposes; the runner decides.',
        ],
    },
};

type Slot = {
    src: string;
    /**
     * A higher-resolution copy for the hover enlargement. `src` is sized for
     * the 400px rail; loading a 3040px file to fill that slot would be a
     * third of a megabyte spent on a thumbnail.
     */
    large?: string;
    poster?: string;
    caption: string;
    proves: string;
};
const SLOTS: Record<string, Slot[]> = {
    'ar-work-of-art': [
        {
            src: '/case-studies/ar-work-of-art/particles-star.jpg',
            large: '/case-studies/ar-work-of-art/particles-star-large.jpg',
            caption: 'A block resolving into a particle burst, mid-run.',
            proves: 'That hitting a block writes into the space rather than incrementing a counter.',
        },
        {
            src: '/case-studies/ar-work-of-art/particles-dense.jpg',
            large: '/case-studies/ar-work-of-art/particles-dense-large.jpg',
            caption: 'The room later in a sustained run, thick with accumulated effects.',
            proves: 'The artwork as a readout of performance — this is what playing well looks like.',
        },
        {
            src: '/case-studies/ar-work-of-art/particles-early.jpg',
            large: '/case-studies/ar-work-of-art/particles-early-large.jpg',
            caption: 'The same environment sparser, before the effects build up.',
            proves: 'The contrast the design depends on: missing does not deduct points, it takes the art away.',
        },
    ],
    'i-am-you': [
        {
            src: '/case-studies/i-am-you/trail-camera.jpg',
            large: '/case-studies/i-am-you/trail-camera-large.jpg',
            caption: 'The trail-camera view: greyscale, vignetted, grainy — the hiker seen from the position the player occupies.',
            proves: 'That the conceit is legible without interface furniture. You know you are looking through a camera because the world stops being in colour.',
        },
        {
            src: '/case-studies/i-am-you/colour-world.jpg',
            large: '/case-studies/i-am-you/colour-world-large.jpg',
            caption: 'The same forest in colour, outside the camera feed.',
            proves: 'The contrast the desaturation is doing — colour is reserved for when you are not watching through a lens.',
        },
        {
            src: '/case-studies/i-am-you/ice-cream-man.jpg',
            large: '/case-studies/i-am-you/ice-cream-man-large.jpg',
            caption: 'The Ice Cream Man — grief as a soft-serve silhouette.',
            proves: 'The tonal bet the project makes: heavy subject, deliberately ridiculous monster.',
        },
        {
            src: '/case-studies/i-am-you/polaroid.jpg',
            large: '/case-studies/i-am-you/polaroid-large.jpg',
            caption: 'A Polaroid on the forest floor, found by flashlight.',
            proves: 'The whole activity: searching a dark forest for a photograph, from a body you are steering rather than occupying.',
        },
    ],
    'truth-of-the-ancient-forest': [
        {
            src: '/case-studies/truth-of-the-ancient-forest/sprite-sheet.jpg',
            large: '/case-studies/truth-of-the-ancient-forest/sprite-sheet-large.jpg',
            caption: 'The production sheet: four sets of role tokens, durability meters, and the spell deck. Abstract card art by Divine Siam.',
            proves: 'That the visual language came from the laser cutter — line work on solid black, no gradients, legible at token size.',
        },
        {
            src: '/case-studies/truth-of-the-ancient-forest/temple-tiles.jpg',
            large: '/case-studies/truth-of-the-ancient-forest/temple-tiles-large.jpg',
            caption: 'The ancient temple tiles, in the abstract style that replaced the religious imagery of versions 1 and 2.',
            proves: 'The cut that mattered most, in the form it took afterwards.',
        },
        {
            src: '/case-studies/truth-of-the-ancient-forest/board-tiles.jpg',
            large: '/case-studies/truth-of-the-ancient-forest/board-tiles-large.jpg',
            caption: 'Numbered floor tiles and dark wall tiles — the pieces the map is built from during play.',
            proves: 'That there is no printed board; the space is assembled by the players as they move into it.',
        },
    ],
    recollection: [
        {
            src: '/case-studies/recollection/share-card.jpg',
            large: '/case-studies/recollection/share-card-large.jpg',
            caption: 'The product\u2019s own share card, in Playfair Display and Pinyon Script.',
            proves: 'That it is a real commercial thing with an identity, not a prototype \u2014 and that the copy carries the argument the thesis made.',
        },
    ],
    spark: [
        {
            src: '/case-studies/spark/system-map.jpg',
            large: '/case-studies/spark/system-map-large.jpg',
            caption: 'The system map: outreach, inputs, session, outcomes.',
            proves: 'That the three rules are the whole mechanism — elder defines the goal, cards guide the session, facilitator steps back.',
        },
        {
            src: '/case-studies/spark/heros-journey.jpg',
            large: '/case-studies/spark/heros-journey-large.jpg',
            caption: 'Fifteen stages from exclusion to community spread, with each dignity pillar marked where it activates.',
            proves: 'The framework applied as structure rather than quoted as a value — autonomy at the handover, merit when her knowledge becomes the game.',
        },
        {
            src: '/case-studies/spark/perception-gap.jpg',
            large: '/case-studies/spark/perception-gap-large.jpg',
            caption: 'The perception gap, and the answer to it: change who holds the pen.',
            proves: 'The reframe the whole project rests on — that these are not knowledge gaps.',
        },
        {
            src: '/case-studies/spark/personas.jpg',
            large: '/case-studies/spark/personas-large.jpg',
            caption: 'Margaret and Emma. Constructed from published survey data, not interviewed.',
            proves: 'That the same failure was designed for from both ends, rather than treating the older adult as the problem.',
        },
        {
            src: '/case-studies/spark/service-blueprint.jpg',
            large: '/case-studies/spark/service-blueprint-large.jpg',
            caption: 'Six phases across physical evidence, both participants, onstage and backstage facilitation.',
            proves: 'That the design covers what happens before arrival and after everyone goes home.',
        },
        {
            src: '/case-studies/spark/storyboard.jpg',
            large: '/case-studies/spark/storyboard-large.jpg',
            caption: 'The session as ten panels — the facilitator is gone by the eighth.',
            proves: 'The disappearing facilitator, which is easier to see than to describe.',
        },
        {
            src: '/case-studies/spark/research-board.jpg',
            large: '/case-studies/spark/research-board-large.jpg',
            caption: 'The research board, unretouched: the direction that became Spark, with the affordance argument on the green note.',
            proves: 'That the card game was reasoned to rather than assumed — "simple rules, but real engagement", against feeling like a kindergarten activity.',
        },
        {
            src: '/case-studies/spark/palette.jpg',
            large: '/case-studies/spark/palette-large.jpg',
            caption: 'Palette and type, checked for WCAG AA with high-contrast pairings for low-vision users.',
            proves: 'Legibility treated as a build constraint for an audience in their seventies and eighties.',
        },
    ],
    'buddy-run': [
        {
            src: '/case-studies/buddy-run/design-screens.jpg',
            large: '/case-studies/buddy-run/design-screens-large.jpg',
            caption:
                'The final interface design by Yunbing Han: baseline explainer, weekly plan, and run history.',
            proves:
                'The product as designed — the buddy, the planner and the restraint-first copy that the build never reached.',
        },
        {
            src: '/case-studies/buddy-run/built-screens.jpg',
            large: '/case-studies/buddy-run/built-screens-large.jpg',
            caption:
                'The same app as implemented, reading live from the Whoop strap at 79 bpm.',
            proves:
                'That the biometric loop actually ran on a device, and exactly how much narrower the build is than the design.',
        },
    ],
    'inhabiting-memory': [
        {
            src: '/case-studies/inhabiting-memory/locomotion.mp4',
            poster: '/case-studies/inhabiting-memory/locomotion.jpg',
            caption: 'One pass through the museum: walking inside a module, then teleporting to the next.',
            proves: 'The locomotion decision, which a screenshot cannot show at all.',
        },
        {
            src: '/case-studies/inhabiting-memory/temporal-splat.mp4',
            poster: '/case-studies/inhabiting-memory/temporal-splat.jpg',
            caption: 'A moving reconstruction, filmed with the head moving.',
            proves: 'That the reconstruction holds together under parallax, and the difference between a place and a moment.',
        },
        {
            src: '/case-studies/inhabiting-memory/flat-vs-spatial.mp4',
            poster: '/case-studies/inhabiting-memory/flat-vs-spatial.jpg',
            caption: 'The same submitted photographs on a screen, then stood inside.',
            proves: 'The study’s comparison, in the form the participants met it.',
        },
        {
            src: '/case-studies/inhabiting-memory/room-scale.mp4',
            poster: '/case-studies/inhabiting-memory/room-scale.jpg',
            caption: 'A participant in the study room: body walking the module, hands raised to teleport.',
            proves: 'That this is physical and embodied, and shows the real play space that constrained the design.',
        },
        {
            src: '/case-studies/inhabiting-memory/hand-tracking.mp4',
            poster: '/case-studies/inhabiting-memory/hand-tracking.jpg',
            caption: 'Hand-tracked menu selection and teleport, close on the hands.',
            proves: 'The interaction layer, and the decision to use no controllers.',
        },
        {
            src: '/case-studies/inhabiting-memory/module-diagram.png',
            caption: 'Real play space, virtual module, and the teleport network across the level.',
            proves: 'The single design idea the rest of the layout is built on.',
        },
        {
            src: '/case-studies/inhabiting-memory/mockups.jpg',
            caption: 'The original iPad mockups, unretouched.',
            proves: 'Process — the thinking before the build, rather than the artifact after it.',
        },
        {
            src: '/case-studies/inhabiting-memory/rooms.jpg',
            caption: 'One frame from each of the six rooms.',
            proves: 'That the interpretive half came from six different people, not one aesthetic.',
        },
        {
            src: '/case-studies/inhabiting-memory/failure-state.png',
            caption: 'A reconstruction breaking down: artifacts and unstable geometry.',
            proves: 'Command of the medium’s failure mode, which the whole design is built to manage.',
        },
    ],
};

const slots = (p.caseStudy ? SLOTS[p.caseStudy] ?? [] : [])
    .filter((s) => hasAsset(s.src))
    .map((s) => ({
        ...s,
        url: assetUrl(s.src),
        largeUrl: s.large && hasAsset(s.large) ? assetUrl(s.large) : assetUrl(s.src),
        posterUrl: s.poster && hasAsset(s.poster) ? assetUrl(s.poster) : undefined,
        isVideo: s.src.endsWith('.mp4'),
    }));

// The hero is the project video where there is one. For a case study a static
// splat still is deliberately not the fallback: it reads as a noisy photograph
// and undersells the work to anyone who has never worn a headset, so the hero
// falls back to type on the project's own gradient instead.
const heroVideo = media.video;
const heroStill = p.noStillHero ? null : media.poster;
const disciplines = projectDisciplines(p);
const demo = p.caseStudy ? DEMOS[p.caseStudy] : undefined;
const demoOk = demo && hasAsset(demo.src);
const others = PROJECTS.filter((o) => o.id !== p.id).slice(0, 4);

const title = `${p.name} — Tomme Denney`;
const description = p.caption ?? `${p.desc.slice(0, 175).trimEnd()}…`;
---

<Base
    title={title}
    description={description}
    path={projectHref(p.name)}
    image={media.poster ?? p.cover}
    ogType="article"
>
    <SiteNav current="work" />

    <main id="main">
        {(heroVideo || heroStill) && (
            <div class="cs-hero">
                {heroVideo ? (
                    <video
                        src={heroVideo}
                        poster={media.poster ?? undefined}
                        autoplay muted loop playsinline preload="metadata"
                        data-hero-video
                        aria-label={`${p.name} — looping preview`}></video>
                ) : (
                    <img src={heroStill!} alt={`${p.name} — cover`} />
                )}
            </div>
        )}

        <div class="shell">
            <header class="cs-head">
                <p class="label">{p.caseStudy ? 'Case study' : 'Project'}</p>
                <h1 class="display" style="margin-top:16px">{p.name}</h1>
                {p.caption && <p class="cs-dek">{p.caption}</p>}
                <div class="cs-meta">
                    <span>{p.cat}</span>
                    {disciplines.map((d) => <span>{d}</span>)}
                </div>
            </header>

            {demoOk && demo && (
                <section class="band" aria-labelledby="demo-h">
                    <div class="band-grid">
                        <p class="label band-label" id="demo-h">Prototype</p>
                        <div class="demo">
                            <div class="demo-phone">
                                <video
                                    src={assetUrl(demo.src)}
                                    poster={demo.poster && hasAsset(demo.poster) ? assetUrl(demo.poster) : undefined}
                                    controls
                                    muted
                                    loop
                                    playsinline
                                    preload="metadata"
                                    aria-label={demo.caption}></video>
                            </div>
                            <div class="demo-notes">
                                <p class="muted" style="font-size:14px">{demo.caption}</p>
                                <ul>
                                    {demo.notes.map((n) => <li set:html={n.replace(/"([^"]+)"/g, '<em>$1</em>')} />)}
                                </ul>
                            </div>
                        </div>
                    </div>
                </section>
            )}

            {/* Prose left, evidence in a rail on the right. Stacked, the page
                was as tall as the writing plus the pictures; side by side it is
                as tall as whichever is taller, and the figures are in view
                while the argument they support is being read. The rail
                collapses under the prose on narrow screens, and the whole
                thing falls back to one column when a case study has no
                evidence yet. */}
            <section class={slots.length > 0 ? 'cs-body cs-split' : 'cs-body'}>
                <div class="cs-main">
                    <p class="label" style="margin-bottom:22px">{Content ? 'Case study' : 'Overview'}</p>
                    {Content ? <Content /> : <div class="prose"><p>{p.desc}</p></div>}

                    {(ext || p.dl) && (
                        <p class="stack" style="margin-top:44px">
                            {ext && <a class="btn" href={ext.url} target="_blank" rel="noopener">{ext.label}</a>}
                            {p.dl && (
                                <a class="btn" href={assetUrl(p.dl)} target="_blank" rel="noopener">{p.dlLabel ?? 'Download'}</a>
                            )}
                        </p>
                    )}
                </div>

                {slots.length > 0 && (
                    <aside class="cs-side" aria-labelledby="ev-h">
                        <p class="label" id="ev-h" style="margin-bottom:22px">Evidence</p>
                        {slots.map((s) => (
                            <figure class="fig fig-rail">
                                {s.isVideo ? (
                                    <video src={s.url} poster={s.posterUrl} controls muted loop playsinline preload="none"></video>
                                ) : (
                                    /* An anchor, not a div with a handler: hovering shows the
                                       enlargement, and tapping or pressing Enter opens the
                                       full-resolution file. A rail figure is 400px wide and
                                       these are dense interface screenshots — at that size
                                       each phone is about 130px across and unreadable. */
                                    <a
                                        class="fig-zoom"
                                        href={s.largeUrl}
                                        target="_blank"
                                        rel="noopener"
                                        style={`--zoom:url("${s.largeUrl}")`}
                                        aria-label={`${s.caption} — open full size`}
                                    >
                                        <img src={s.url} alt={s.caption} loading="lazy" decoding="async" />
                                        <span class="fig-hint">Hover to enlarge &middot; click for full size</span>
                                    </a>
                                )}
                                <figcaption>
                                    {s.caption}
                                    <span class="fig-proves">{s.proves}</span>
                                </figcaption>
                            </figure>
                        ))}
                    </aside>
                )}
            </section>

            {embed && (
                <section class="band" aria-labelledby="play-h">
                    <div class="band-grid">
                        <p class="label band-label" id="play-h">Play in browser</p>
                        <div>
                            <iframe
                                src={embed.src}
                                title={`${p.name} — playable build`}
                                loading="lazy"
                                allowfullscreen
                                allow="autoplay; fullscreen *; gamepad"
                                style="width:100%;aspect-ratio:16/9;border:0;background:#04151f"></iframe>
                            {embed.itchio && (
                                <p style="margin-top:18px">
                                    <a class="btn" href={embed.itchio} target="_blank" rel="noopener">Itch.io ↗</a>
                                </p>
                            )}
                        </div>
                    </div>
                </section>
            )}

            {media.gallery.length > 0 && (
                <section class="band" aria-labelledby="gal-h">
                    <div class="band-grid">
                        <p class="label band-label" id="gal-h">Stills</p>
                        <div class="photos">
                            {media.gallery.map((src, i) => (
                                <figure><img src={src} alt={`${p.name} — still ${i + 1}`} loading="lazy" decoding="async" /></figure>
                            ))}
                        </div>
                    </div>
                </section>
            )}

            {(p.presentation || p.documents?.length) && (
                <section class="band" aria-labelledby="doc-h">
                    <div class="band-grid">
                        <p class="label band-label" id="doc-h">Documents</p>
                        <div>
                            <ul class="docs">
                                {p.presentation && (
                                    <li>
                                        <a href={p.presentation} target="_blank" rel="noopener">Thesis presentation</a>
                                        <span>The deck as presented at the showcase.</span>
                                    </li>
                                )}
                                {p.documents?.map((d) => (
                                    <li>
                                        <a href={d.file} target="_blank" rel="noopener">{d.label}</a>
                                        {d.note && <span>{d.note}</span>}
                                    </li>
                                ))}
                            </ul>
                        </div>
                    </div>
                </section>
            )}

            <section class="band">
                <div class="band-grid">
                    <p class="label band-label">Next</p>
                    <div>
                        <ol class="index">
                            {others.map((o, i) => (
                                <li class="index-row">
                                    <a class="index-link" href={projectHref(o.name)}>
                                        <span class="index-num">{String(i + 1).padStart(2, '0')}</span>
                                        <span>
                                            <span class="index-name">{o.name}</span>
                                            <span class="index-meta">{o.cat}</span>
                                        </span>
                                        <span class="index-kind" data-kind={o.caseStudy ? 'case' : 'project'}>
                                            {o.caseStudy ? 'Case study' : 'Project'}
                                        </span>
                                    </a>
                                </li>
                            ))}
                        </ol>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <SiteFooter />

    <script is:inline>
        if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
            document.querySelectorAll('video[data-hero-video]').forEach(function (v) {
                v.removeAttribute('autoplay');
                v.pause();
            });
        }
    </script>
</Base>
